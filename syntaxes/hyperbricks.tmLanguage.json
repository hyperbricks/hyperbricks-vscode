{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "HyperBricks",
  "scopeName": "source.hyperbricks-yaml",
  "comment": "YAML owns indentation, mappings, quoting, comments and scalar boundaries. HyperBricks injections only decorate keys and values after YAML has classified them; schema-aware distinctions come from semantic tokens.",
  "patterns": [
    {
      "include": "source.yaml"
    }
  ],
  "injections": {
    "L:source.hyperbricks-yaml meta.map.key.yaml - meta.scalar.yaml - comment, L:source.hyperbricks-yaml meta.flow.map.key.yaml - meta.scalar.yaml - comment": {
      "patterns": [
        {
          "include": "#inherit-key"
        },
        {
          "include": "#type-key"
        },
        {
          "include": "#file-keywords"
        },
        {
          "include": "#root-components"
        },
        {
          "include": "#component-fields"
        },
        {
          "include": "#resolver-keys"
        }
      ]
    },
    "L:source.hyperbricks-yaml string - entity.name.tag - meta.scalar.yaml - comment": {
      "patterns": [
        {
          "include": "#component-types"
        },
        {
          "include": "#inheritance-values"
        },
        {
          "include": "#path-bases"
        }
      ]
    },
    "L:source.hyperbricks-yaml string.unquoted.block.yaml - comment - meta.template.expression.hyperbricks": {
      "patterns": [
        {
          "include": "#go-template"
        }
      ]
    },
    "L:source.hyperbricks-yaml string.quoted.single.yaml - entity.name.tag - comment - meta.template.expression.hyperbricks": {
      "patterns": [
        {
          "include": "#inline-template-single"
        }
      ]
    },
    "L:source.hyperbricks-yaml string.quoted.double.yaml - entity.name.tag - comment - meta.template.expression.hyperbricks": {
      "patterns": [
        {
          "include": "#inline-template-double"
        }
      ]
    },
    "L:source.hyperbricks-yaml string.unquoted.plain - entity.name.tag - comment - meta.template.expression.hyperbricks": {
      "patterns": [
        {
          "include": "#inline-template-plain"
        }
      ]
    }
  },
  "repository": {
    "inherit-key": {
      "name": "keyword.control.inherit.hyperbricks",
      "match": "(?<=^[\\t ]*-[\\t ]+['\"]?)inherit(?=['\"]?[\\t ]*:)"
    },
    "type-key": {
      "name": "keyword.control.type.hyperbricks",
      "match": "(?<=^[\\t ]*-[\\t ]+['\"]?)type(?=['\"]?[\\t ]*:)"
    },
    "file-keywords": {
      "name": "keyword.control.hyperbricks",
      "match": "(?<=^['\"]?)(?:imports|vars)(?=['\"]?[\\t ]*:)"
    },
    "root-components": {
      "name": "entity.name.tag.component.hyperbricks",
      "match": "(?<=^['\"]?)[A-Za-z_][A-Za-z0-9_.-]*(?=['\"]?[\\t ]*:)"
    },
    "component-fields": {
      "name": "support.type.property-name.hyperbricks",
      "match": "(?<=^[\\t ]*-[\\t ]+['\"]?)[A-Za-z_][A-Za-z0-9_.@-]*(?=['\"]?[\\t ]*:)"
    },
    "resolver-keys": {
      "name": "entity.name.tag.resolver.hyperbricks",
      "match": "\\G(?:var|env|config|path|file|format|args|base|parts)(?=['\"]?[\\t ]*:)"
    },
    "component-types": {
      "name": "support.type.component.hyperbricks",
      "match": "(?<=^[\\t ]*-[\\t ]+['\"]?type['\"]?:[\\t ]+['\"]?)(?:<(?:HYPERMEDIA|FRAGMENT|API_RENDER|API_FRAGMENT_RENDER|TREE|HEAD|TEMPLATE|HTML|TEXT|CSS|JAVASCRIPT|JS|IMAGE|IMAGES|JSON|JSON_RENDER|MENU|PLUGIN|STYLES|MARKDOWN|GOJA_RENDER|ESBUILD)>|(?:hypermedia|fragment|api_render|api_fragment_render|tree|head|template|html|text|css|javascript|js|image|images|json|json_render|menu|plugin|styles|markdown|goja_render|esbuild))(?=['\"]?[\\t ]*(?:#.*)?$)"
    },
    "inheritance-values": {
      "name": "entity.other.inherited-class.hyperbricks",
      "match": "(?<=^[\\t ]*-[\\t ]+['\"]?inherit['\"]?:[\\t ]+['\"]?)[A-Za-z_][A-Za-z0-9_.\\[\\]-]*(?=['\"]?[\\t ]*(?:#.*)?$)"
    },
    "path-bases": {
      "name": "support.constant.path-base.hyperbricks",
      "match": "\\G(?<=\\bbase['\"]?:[\\t ]+['\"]?)(?:module_root|root|module|resources|templates|static|hyperbricks|render)(?=['\"]?(?:[\\t ]|[,}\\]]|$))"
    },
    "inline-template-single": {
      "comment": "Only complete expressions inside this YAML scalar can enter template state. An unfinished expression must not consume the closing YAML quote or subsequent comments.",
      "match": "\\{\\{-?(?:[^'\\r\\n]|'')*?-?\\}\\}",
      "captures": {
        "0": {
          "name": "meta.template.expression.hyperbricks",
          "patterns": [{ "include": "#go-template" }]
        }
      }
    },
    "inline-template-double": {
      "match": "\\{\\{-?(?:[^\\\"\\\\\\r\\n]|\\\\.)*?-?\\}\\}",
      "captures": {
        "0": {
          "name": "meta.template.expression.hyperbricks",
          "patterns": [{ "include": "#go-template" }]
        }
      }
    },
    "inline-template-plain": {
      "match": "\\{\\{-?(?:(?![\\t ]+#)[^\\r\\n])*?-?\\}\\}",
      "captures": {
        "0": {
          "name": "meta.template.expression.hyperbricks",
          "patterns": [{ "include": "#go-template" }]
        }
      }
    },
    "go-template": {
      "name": "meta.template.expression.hyperbricks",
      "begin": "\\{\\{-?",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.template.begin.hyperbricks"
        }
      },
      "end": "-?\\}\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.template.end.hyperbricks"
        }
      },
      "patterns": [
        {
          "begin": "/\\*",
          "end": "\\*/",
          "name": "comment.block.template.hyperbricks"
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.template.hyperbricks",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.template.hyperbricks"
            }
          ]
        },
        {
          "begin": "`",
          "end": "`",
          "name": "string.quoted.raw.template.hyperbricks"
        },
        {
          "match": "\\b(if|else|end|range|with|template|block|define)\\b",
          "name": "keyword.control.template.hyperbricks"
        },
        {
          "match": "\\.[A-Za-z_][A-Za-z0-9_.]*",
          "name": "variable.other.template.hyperbricks"
        },
        {
          "match": "\\$[A-Za-z_][A-Za-z0-9_]*",
          "name": "variable.other.template.hyperbricks"
        }
      ]
    }
  }
}
